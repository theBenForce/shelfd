{
  "name": "@shelfd/plugin-notebooklm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Built-in Shelfd action & MCP plugin for exporting compiled book Markdown, highlights, and notes to Google NotebookLM",
  "scripts": {
    "build": "shelfd-plugin build .",
    "verify": "shelfd-plugin verify .",
    "pack": "shelfd-plugin pack .",
    "test": "shelfd-plugin verify . && node --test ./test/*.test.mjs",
    "lint": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@shelfd/plugin-sdk": "workspace:*"
  }
}
