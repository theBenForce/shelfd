{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "go.mod",
        "go.sum",
        "lib/**",
        "pubspec.yaml",
        "pubspec.lock",
        "!dist/**",
        "!build/**"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "go.mod",
        "go.sum",
        "lib/**",
        "test/**",
        "pubspec.yaml"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "lib/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
