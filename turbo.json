{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build:web": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "lib/**",
        "web/**",
        "pubspec.yaml",
        "pubspec.lock"
      ],
      "outputs": [
        "build/web/**"
      ]
    },
    "@shelfd/server#build": {
      "dependsOn": ["^build:web"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "go.mod",
        "go.sum",
        "!dist/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@shelfd/app#build": {
      "dependsOn": ["build:web"],
      "outputs": [
        "build/web/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "go.mod",
        "go.sum",
        "lib/**",
        "test/**",
        "pubspec.yaml"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "lib/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
