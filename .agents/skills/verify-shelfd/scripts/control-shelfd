start_web_and_ai_stub() {
  local web_root="${REPO_ROOT}/apps/app/build/web"
  WEB_ROOT="$web_root" AI_PORT="$AI_PORT" nohup node -e '
    const http = require("node:http");
    const fs = require("node:fs");
    const path = require("node:path");
    const crypto = require("node:crypto");

    const webRoot = process.env.WEB_ROOT;
    const port = Number(process.env.AI_PORT);
    const mime = {
      ".html": "text/html; charset=utf-8",
      ".js": "application/javascript",
      ".mjs": "application/javascript",
      ".wasm": "application/wasm",
      ".json": "application/json",
      ".css": "text/css; charset=utf-8",
      ".png": "image/png",
      ".svg": "image/svg+xml",
      ".ttf": "font/ttf",
      ".otf": "font/otf",
      ".woff2": "font/woff2",
    };

    function deterministicVector(text, dims = 256) {
      const vec = new Array(dims).fill(0);
      const tokens = String(text || "").toLowerCase().match(/[a-z0-9]+/g) || ["empty"];
      for (const tok of tokens) {
        const h = crypto.createHash("sha256").update(tok).digest();
        for (let i = 0; i < dims; i++) {
          vec[i] += ((h[i % h.length] / 127.5) - 1.0);
        }
      }
      const norm = Math.sqrt(vec.reduce((s, v) => s + v * v, 0)) || 1;
      return vec.map((v) => Number((v / norm).toFixed(6)));
    }

    const server = http.createServer((req, res) => {
      const u = new URL(req.url, `http://127.0.0.1:${port}`);

      // External Ollama AI provider boundary for deterministic offline embeddings & summaries
      if (req.method === "GET" && u.pathname === "/api/tags") {
        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ models: [{ name: "nomic-embed-text" }, { name: "llama3.2:3b" }] }));
        return;
      }
      if (req.method === "POST" && (u.pathname === "/api/embed" || u.pathname === "/api/embeddings")) {
        let body = "";
        req.on("data", (c) => (body += c));
        req.on("end", () => {
          const parsed = JSON.parse(body || "{}");
          const inputs = Array.isArray(parsed.input) ? parsed.input : [parsed.input ?? parsed.prompt ?? ""];
          const embeddings = inputs.map((t) => deterministicVector(t, 256));
          res.writeHead(200, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ model: parsed.model || "nomic-embed-text", embeddings, embedding: embeddings[0] }));
        });
        return;
      }
      if (req.method === "POST" && (u.pathname === "/api/chat" || u.pathname === "/api/generate")) {
        let body = "";
        req.on("data", (c) => (body += c));
        req.on("end", () => {
          res.writeHead(200, { "Content-Type": "application/json" });
          res.end(JSON.stringify({
            model: "llama3.2:3b",
            done: true,
            response: "Verification summary.",
            message: { role: "assistant", content: "Verification summary." },
          }));
        });
        return;
      }

      if (u.pathname === "/__verify_health") {
        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true }));
        return;
      }

      const rel = decodeURIComponent(u.pathname === "/" ? "index.html" : u.pathname.slice(1));
      let target = path.resolve(webRoot, rel);
      if (!target.startsWith(path.resolve(webRoot))) {
        res.writeHead(403);
        res.end("Forbidden");
        return;
      }
      if (!fs.existsSync(target) || fs.statSync(target).isDirectory()) {
        if (path.extname(u.pathname)) {
          res.writeHead(404);
          res.end("Not found");
          return;
        }
        target = path.join(webRoot, "index.html");
      }
      res.writeHead(200, {
        "Content-Type": mime[path.extname(target)] || "application/octet-stream",
        "Cache-Control": "no-cache",
      });
      fs.createReadStream(target).pipe(res);
    });

    server.listen(port, "127.0.0.1");
  ' >"$WEB_LOG" 2>&1 &
  echo $! >"$WEB_PID_FILE"
}

do_launch() {
  if is_stack_reachable; then
    echo "Shelfd verification stack already running (API=${API_URL}, WEB=${WEB_URL}, AI=${AI_URL}, CDP=127.0.0.1:${CDP_PORT})"
    return 0
  fi

  # Clean any partial stale processes we previously started in this PID namespace
  stop_pid_file "$BROWSER_PID_FILE" "remote-debugging-port=${CDP_PORT}"
  stop_pid_file "$WEB_PID_FILE" "WEB_ROOT"
  stop_pid_file "$SERVER_PID_FILE" "${SERVER_BIN}"

  check_port_free "$API_PORT" "Shelfd API & SPA"
  check_port_free "$AI_PORT" "Ollama AI Boundary Stub"
  check_port_free "$CDP_PORT" "Chromium CDP"

  local chrome_bin
  chrome_bin="$(resolve_chrome_bin)" || {
    echo "ERROR: No Chromium or Google Chrome executable found. Set SHELFD_CHROME_BIN." >&2
    return 1
  }

  rm -rf "$RUNTIME_DIR"
  seed_fixtures_and_config
  ensure_web_bundle

  echo "==> Building Shelfd server binary (${SERVER_BIN})..."
  (
    cd "${REPO_ROOT}/apps/server"
    run_tool go build -tags sqlite_fts5 -o "$SERVER_BIN" ./cmd/server
  )

  start_web_and_ai_stub
  for _ in $(seq 1 30); do
    if curl -fsS "${AI_URL}/__verify_health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done

  echo "==> Running initial library scan against disposable library..."
  (
    cd "$RUNTIME_DIR"
    SHELFD_MCP_TOKEN="$MCP_TOKEN" "$SERVER_BIN" -config "$CONFIG_FILE" -scan >>"$SERVER_LOG" 2>&1
  )

  echo "==> Starting isolated Shelfd daemon on ${API_URL}..."
  (
    cd "$RUNTIME_DIR"
    SHELFD_MCP_TOKEN="$MCP_TOKEN" nohup "$SERVER_BIN" -config "$CONFIG_FILE" >>"$SERVER_LOG" 2>&1 &
    echo $! >"$SERVER_PID_FILE"
  )

  for _ in $(seq 1 50); do
    if curl -fsS "${API_URL}/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done
  if ! curl -fsS "${API_URL}/health" >/dev/null 2>&1; then
    echo "ERROR: Shelfd server failed to become healthy at ${API_URL}/health" >&2
    tail -n 40 "$SERVER_LOG" >&2 || true
    return 1
  fi

  # Authenticate via POST /api/v1/auth/login to store admin JWT for API/upload helpers
  local login_json
  login_json="$(curl -fsS -X POST "${API_URL}/api/v1/auth/login" \
    -H "Content-Type: application/json" \
    -d "{\"username\":\"${ADMIN_USER}\",\"password\":\"${ADMIN_PASS}\"}")"
  printf '%s' "$login_json" | node -e '
    const fs = require("node:fs");
    const data = JSON.parse(fs.readFileSync(0, "utf8"));
    if (!data.token) process.exit(1);
    process.stdout.write(data.token);
  ' >"$TOKEN_FILE"

  echo "==> Starting headless Chromium on CDP 127.0.0.1:${CDP_PORT} -> ${WEB_URL}/connect..."
  mkdir -p "$CHROME_PROFILE_DIR"
  nohup "$chrome_bin" \
    --headless=new \
    --no-sandbox \
    --disable-gpu \
    --enable-unsafe-swiftshader \
    --disable-dev-shm-usage \
    --mute-audio \
    --window-size=1440,900 \
    --autoplay-policy=no-user-gesture-required \
    --force-renderer-accessibility \
    --proxy-bypass-list="<-loopback>" \
    --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$CHROME_PROFILE_DIR" \
    "${WEB_URL}/connect" >"$BROWSER_LOG" 2>&1 &
  echo $! >"$BROWSER_PID_FILE"

  for _ in $(seq 1 50); do
    if curl -fsS "http://127.0.0.1:${CDP_PORT}/json/version" >/dev/null 2>&1; then
      break
    fi
    sleep 0.25
  done
  if ! curl -fsS "http://127.0.0.1:${CDP_PORT}/json/version" >/dev/null 2>&1; then
    echo "ERROR: Chromium CDP failed to start on 127.0.0.1:${CDP_PORT}" >&2
    tail -n 40 "$BROWSER_LOG" >&2 || true
    return 1
  fi

  # Prime console hook and initial Flutter semantics tree
  node "${SCRIPT_DIR}/browser-cdp.mjs" goto "/connect" --wait-ms 3000 >/dev/null

  echo "LAUNCH OK: API=${API_URL} WEB=${WEB_URL} AI=${AI_URL} CDP=127.0.0.1:${CDP_PORT} RUNTIME=${RUNTIME_DIR} EVIDENCE=${EVIDENCE_DIR}"

  if [[ "${1:-}" == "--foreground" ]]; then
    echo $$ >"$DAEMON_PID_FILE"
    shutdown_fg() {
      stop_pid_file "$BROWSER_PID_FILE" "remote-debugging-port=${CDP_PORT}"
      stop_pid_file "$WEB_PID_FILE" "WEB_ROOT"
      stop_pid_file "$SERVER_PID_FILE" "${SERVER_BIN}"
      exit 0
    }
    trap shutdown_fg INT TERM
    while [[ ! -f "$STOP_SIGNAL_FILE" ]] &&
          is_pid_alive "$SERVER_PID_FILE" "${SERVER_BIN}" &&
          is_pid_alive "$WEB_PID_FILE" &&
          is_pid_alive "$BROWSER_PID_FILE" "remote-debugging-port=${CDP_PORT}"; do
      sleep 0.25
    done
    shutdown_fg
  fi
}

do_doctor() {
  for bin in node python3 curl; do
    command -v "$bin" >/dev/null 2>&1 || { echo "FAIL: '$bin' missing on PATH" >&2; return 1; }
  done
  resolve_chrome_bin >/dev/null || { echo "FAIL: Chromium/Chrome binary missing" >&2; return 1; }

  if [[ "$RUNTIME_DIR" != /tmp/* ]]; then
    echo "FAIL: RUNTIME_DIR (${RUNTIME_DIR}) must reside under /tmp for isolation" >&2
    return 1
  fi

  [[ -f "$TOKEN_FILE" ]] || { echo "FAIL: Missing ${TOKEN_FILE} (run 'launch')" >&2; return 1; }
  curl -fsS "${AI_URL}/__verify_health" >/dev/null 2>&1 || { echo "FAIL: Ollama AI boundary stub unreachable on ${AI_URL} (run 'launch')" >&2; return 1; }

  local health
  health="$(curl -fsS "${API_URL}/health" 2>/dev/null)" || { echo "FAIL: Shelfd API server unreachable on ${API_URL} (run 'launch')" >&2; return 1; }
  [[ "$health" == *'"status":"ok"'* ]] || { echo "FAIL: /health unexpected response: $health" >&2; return 1; }

  # Verify Shelfd SPA handler serves index.html on deep routes (/connect)
  curl -fsS "${WEB_URL}/connect" | grep -qi "flutter" || {
    echo "FAIL: Shelfd SPA fallback on ${WEB_URL}/connect did not serve Flutter index.html" >&2
    return 1
  }

  # Verify cross-origin CORS preflight permits Cache-Control (SSE invariant)
  local cors_headers
  cors_headers="$(curl -fsSI -X OPTIONS "${API_URL}/api/v1/queue/events" \
    -H "Origin: ${AI_URL}" \
    -H "Access-Control-Request-Method: GET" \
    -H "Access-Control-Request-Headers: Authorization, Content-Type, Accept, Cache-Control")"
  echo "$cors_headers" | grep -qi "Cache-Control" || {
    echo "FAIL: CORS Access-Control-Allow-Headers missing Cache-Control" >&2
    return 1
  }

  # Verify admin JWT auth
  local token me_resp
  token="$(cat "$TOKEN_FILE")"
  me_resp="$(curl -fsS "${API_URL}/api/v1/auth/me" -H "Authorization: Bearer ${token}")"
  [[ "$me_resp" == *"\"username\":\"${ADMIN_USER}\""* ]] || {
    echo "FAIL: /api/v1/auth/me rejected admin token: $me_resp" >&2
    return 1
  }

  # Verify MCP token auth
  curl -fsSI "${API_URL}/mcp" -H "Authorization: Bearer ${MCP_TOKEN}" >/dev/null || {
    echo "FAIL: /mcp HEAD check rejected MCP_TOKEN" >&2
    return 1
  }

  # Verify Audiobookshelf sidecar sanctity (.metadata.json & desc.txt untouched)
  (cd "$RUNTIME_DIR" && sha256sum -c "$SIDECAR_SUMS" >/dev/null) || {
    echo "FAIL: Audiobookshelf sidecar files (.metadata.json / desc.txt) were modified!" >&2
    return 1
  }

  # Verify Chromium CDP target is responsive
  curl -fsS "http://127.0.0.1:${CDP_PORT}/json/list" | grep -q '"type": *"page"' || {
    echo "FAIL: No active page target on Chromium CDP 127.0.0.1:${CDP_PORT}" >&2
    return 1
  }

  echo "DOCTOR OK: API=${API_URL} WEB=${WEB_URL} AI=${AI_URL} CDP=127.0.0.1:${CDP_PORT} sidecars=untouched auth=valid mcp=valid"
}

do_api() {
  local method="${1:?HTTP method required (e.g. GET, POST, PUT, DELETE)}"
  local endpoint="${2:?API path required (e.g. /api/v1/books)}"
  local body="${3:-}"
  local token
  token="$(cat "$TOKEN_FILE")"
  if [[ -n "$body" ]]; then
    curl -fsS -X "$method" "${API_URL}${endpoint}" \
      -H "Authorization: Bearer ${token}" \
      -H "Content-Type: application/json" \
      -d "$body"
  else
    curl -fsS -X "$method" "${API_URL}${endpoint}" \
      -H "Authorization: Bearer ${token}"
  fi
  echo
}

do_upload() {
  local file_path="${1:-${FIXTURES_DIR}/earthsea.epub}"
  [[ -f "$file_path" ]] || { echo "ERROR: Upload file not found: $file_path" >&2; return 1; }
  local token
  token="$(cat "$TOKEN_FILE")"
  curl -fsS -X POST "${API_URL}/api/v1/books/upload" \
    -H "Authorization: Bearer ${token}" \
    -F "file=@${file_path}"
  echo
}

do_mcp() {
  local tool_name="${1:?MCP tool name required (e.g. search_library, get_book_metadata, read_chapter_content)}"
  local default_args='{}'
  local args_json="${2:-$default_args}"
  API_URL="$API_URL" MCP_TOKEN="$MCP_TOKEN" TOOL_NAME="$tool_name" ARGS_JSON="$args_json" node -e '
    (async () => {
      const apiUrl = process.env.API_URL;
      const token = process.env.MCP_TOKEN;
      const toolName = process.env.TOOL_NAME;
      const toolArgs = JSON.parse(process.env.ARGS_JSON || "{}");

      // Streamable HTTP POST directly to /mcp (supported by Shelfd unified MCP handler)
      const initRes = await fetch(`${apiUrl}/mcp`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          jsonrpc: "2.0",
          id: 1,
          method: "initialize",
          params: {
            protocolVersion: "2024-11-05",
            capabilities: {},
            clientInfo: { name: "verify-shelfd", version: "1.0.0" },
          },
        }),
      });
      if (!initRes.ok) {
        throw new Error(`MCP initialize failed: HTTP ${initRes.status}`);
      }

      const callRes = await fetch(`${apiUrl}/mcp`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          jsonrpc: "2.0",
          id: 2,
          method: "tools/call",
          params: { name: toolName, arguments: toolArgs },
        }),
      });
      if (!callRes.ok) {
        throw new Error(`MCP tools/call failed: HTTP ${callRes.status}`);
      }
      const payload = await callRes.json();
      console.log(JSON.stringify(payload, null, 2));
      if (payload.error || payload.result?.isError) {
        process.exit(1);
      }
    })().catch((err) => {
      console.error(err.message);
      process.exit(1);
    });
  '
}

do_state() {
  local token
  token="$(cat "$TOKEN_FILE")"
  API_URL="$API_URL" WEB_URL="$WEB_URL" AI_URL="$AI_URL" RUNTIME_DIR="$RUNTIME_DIR" EVIDENCE_DIR="$EVIDENCE_DIR" \
  LIBRARY_DIR="$LIBRARY_DIR" FIXTURES_DIR="$FIXTURES_DIR" ADMIN_USER="$ADMIN_USER" ADMIN_PASS="$ADMIN_PASS" \
  TOKEN="$token" node -e '
    (async () => {
      const res = await fetch(`${process.env.API_URL}/api/v1/books?limit=50`, {
        headers: { Authorization: `Bearer ${process.env.TOKEN}` },
      });
      const data = await res.json();
      const books = data.books || [];
      const findBook = (substr) => books.find((b) => b.title.toLowerCase().includes(substr));
      console.log(JSON.stringify({
        apiUrl: process.env.API_URL,
        webUrl: process.env.WEB_URL,
        aiStubUrl: process.env.AI_URL,
        runtimeDir: process.env.RUNTIME_DIR,
        evidenceDir: process.env.EVIDENCE_DIR,
        libraryDir: process.env.LIBRARY_DIR,
        uploadFixture: `${process.env.FIXTURES_DIR}/earthsea.epub`,
        adminUser: process.env.ADMIN_USER,
        adminPassword: process.env.ADMIN_PASS,
        books: books.map((b) => ({ id: b.id, title: b.title, hasReadalong: b.has_readalong, bookType: b.book_type })),
        duneBookId: findBook("dune")?.id || null,
        peterRabbitBookId: findBook("peter rabbit")?.id || null,
      }, null, 2));
    })();
  '
}

do_cli() {
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  (
    cd "$RUNTIME_DIR"
    SHELFD_MCP_TOKEN="$MCP_TOKEN" "$SERVER_BIN" -config "$CONFIG_FILE" "$@"
  )
}

do_evidence() {
  mkdir -p "$EVIDENCE_DIR"
  local files=()
  while IFS= read -r -d '' f; do
    files+=("$f")
  done < <(find "$EVIDENCE_DIR" -type f -size +0c -print0 | sort -z)

  if [[ "${#files[@]}" -eq 0 ]]; then
    echo "FAIL: No non-empty evidence files found in ${EVIDENCE_DIR}" >&2
    return 1
  fi

  echo "EVIDENCE OK (${#files[@]} artifact(s) in ${EVIDENCE_DIR}):"
  for f in "${files[@]}"; do
    printf "  - %s (%s bytes)\n" "$f" "$(wc -c <"$f" | tr -d ' ')"
  done
}

do_cleanup() {
  if [[ -d "$RUNTIME_DIR" ]]; then
    touch "$STOP_SIGNAL_FILE" 2>/dev/null || true
  fi
  stop_pid_file "$BROWSER_PID_FILE" "remote-debugging-port=${CDP_PORT}"
  stop_pid_file "$WEB_PID_FILE" "WEB_ROOT"
  stop_pid_file "$SERVER_PID_FILE" "${SERVER_BIN}"
  stop_pid_file "$DAEMON_PID_FILE" "control-shelfd"

  for _ in $(seq 1 40); do
    if ! curl -fsS "${API_URL}/health" >/dev/null 2>&1 &&
       ! curl -fsS "${AI_URL}/__verify_health" >/dev/null 2>&1 &&
       ! curl -fsS "http://127.0.0.1:${CDP_PORT}/json/version" >/dev/null 2>&1; then
      break
    fi
    sleep 0.15
  done

  if [[ -d "$RUNTIME_DIR" && "$RUNTIME_DIR" == /tmp/* ]]; then
    rm -rf "$RUNTIME_DIR"
  fi

  echo "CLEANUP OK: Removed runtime ${RUNTIME_DIR}; evidence preserved at ${EVIDENCE_DIR}"
}

subcmd="${1:-help}"
shift || true

case "$subcmd" in
  launch)
    do_launch "$@"
    ;;
  doctor)
    do_doctor "$@"
    ;;
  browser)
    node "${SCRIPT_DIR}/browser-cdp.mjs" "$@"
    ;;
  api)
    do_api "$@"
    ;;
  upload)
    do_upload "$@"
    ;;
  mcp)
    do_mcp "$@"
    ;;
  state)
    do_state "$@"
    ;;
  cli)
    do_cli "$@"
    ;;
  evidence)
    do_evidence "$@"
    ;;
  cleanup)
    do_cleanup "$@"
    ;;
  *)
    cat <<EOF
Usage: control-shelfd <command> [args...]

Lifecycle:
  launch                         Build & start isolated Shelfd API, Shelf Web SPA, fixtures, and headless Chromium
  doctor                         Read-only health, auth, CORS, MCP, CDP, and sidecar-sanctity check
  state                          Print active ports, credentials, paths, and seeded book IDs as JSON
  evidence                       Verify and list non-empty proof artifacts in ${EVIDENCE_DIR}
  cleanup                        Stop recorded PIDs and delete ${RUNTIME_DIR} (keeps ${EVIDENCE_DIR})

Drivers:
  browser <cmd> [opts]           Drive headless Chromium over CDP (goto, snapshot, click, fill, press, screenshot, console, iframes, eval)
  api <METHOD> <path> [json]     Send authenticated REST request to ${API_URL}
  upload [epub-path]             Upload an EPUB via multipart POST /api/v1/books/upload
  mcp <tool> [args-json]         Invoke an MCP tool over JSON-RPC 2.0 at ${API_URL}/mcp
  cli -- <shelfd-flags...>       Run compiled shelfd CLI against isolated config.yaml
EOF
    ;;
esac
