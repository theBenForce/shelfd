#!/usr/bin/env bash
set -euo pipefail

# Prepend common local toolchain locations (mise, Go, Flutter, Homebrew)
for extra_dir in \
  "/tmp/flutter/bin" \
  "$HOME/flutter/bin" \
  "$HOME/.local/share/mise/shims" \
  "$HOME/.local/bin" \
  "/usr/local/go/bin" \
  "/opt/homebrew/bin"; do
  if [[ -d "$extra_dir" && ":$PATH:" != *":$extra_dir:"* ]]; then
    export PATH="$extra_dir:$PATH"
  fi
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

RUN_ID="${SHELFD_VERIFY_RUN_ID:-default}"
API_PORT="${SHELFD_VERIFY_PORT:-18080}"
AI_PORT="${SHELFD_VERIFY_AI_PORT:-${SHELFD_VERIFY_WEB_PORT:-13000}}"
CDP_PORT="${SHELFD_VERIFY_CDP_PORT:-19222}"

API_URL="http://127.0.0.1:${API_PORT}"
WEB_URL="${SHELFD_VERIFY_WEB_URL:-${API_URL}}"
AI_URL="http://127.0.0.1:${AI_PORT}"

RUNTIME_DIR="${SHELFD_RUNTIME_DIR:-/tmp/shelfd-verify-runtime-${RUN_ID}}"
if [[ -n "${SHELFD_EVIDENCE_DIR:-}" ]]; then
  EVIDENCE_DIR="${SHELFD_EVIDENCE_DIR}"
elif [[ "$RUN_ID" == "default" ]]; then
  EVIDENCE_DIR="/tmp/shelfd-verify-evidence"
else
  EVIDENCE_DIR="/tmp/shelfd-verify-evidence-${RUN_ID}"
fi

ADMIN_USER="${SHELFD_VERIFY_ADMIN_USER:-admin}"
ADMIN_PASS="${SHELFD_VERIFY_ADMIN_PASS:-shelfd-verify-pass-123}"
MCP_TOKEN="${SHELFD_VERIFY_MCP_TOKEN:-shelfd_verify_mcp_token_${RUN_ID}}"
JWT_SECRET="shelfd-verify-jwt-secret-key-32bytes-${RUN_ID}"

SERVER_BIN="${RUNTIME_DIR}/bin/shelfd"
CONFIG_FILE="${RUNTIME_DIR}/config.yaml"
LIBRARY_DIR="${RUNTIME_DIR}/library"
DATA_DIR="${RUNTIME_DIR}/data"
FIXTURES_DIR="${RUNTIME_DIR}/fixtures"
CHROME_PROFILE_DIR="${RUNTIME_DIR}/chrome-profile"
SIDECAR_SUMS="${RUNTIME_DIR}/sidecar-checksums.sha256"
TOKEN_FILE="${RUNTIME_DIR}/admin.jwt"

SERVER_PID_FILE="${RUNTIME_DIR}/server.pid"
WEB_PID_FILE="${RUNTIME_DIR}/web.pid"
BROWSER_PID_FILE="${RUNTIME_DIR}/browser.pid"
DAEMON_PID_FILE="${RUNTIME_DIR}/daemon.pid"

SERVER_LOG="${RUNTIME_DIR}/server.log"
WEB_LOG="${RUNTIME_DIR}/web.log"
BROWSER_LOG="${RUNTIME_DIR}/browser.log"

export SHELFD_VERIFY_CDP_PORT="$CDP_PORT"
export SHELFD_VERIFY_WEB_URL="$WEB_URL"

run_tool() {
  local bin="$1"
  shift
  if command -v "$bin" >/dev/null 2>&1; then
    "$bin" "$@"
  elif command -v mise >/dev/null 2>&1; then
    mise exec -- "$bin" "$@"
  else
    echo "ERROR: Required tool '$bin' not found on PATH (and 'mise' is unavailable)." >&2
    return 1
  fi
}

resolve_chrome_bin() {
  if [[ -n "${SHELFD_CHROME_BIN:-}" && -x "${SHELFD_CHROME_BIN}" ]]; then
    echo "${SHELFD_CHROME_BIN}"
    return 0
  fi
  local candidates=(
    "/usr/lib/chromium/chromium"
    "$(command -v chromium 2>/dev/null || true)"
    "$(command -v chromium-browser 2>/dev/null || true)"
    "$(command -v google-chrome 2>/dev/null || true)"
    "$(command -v google-chrome-stable 2>/dev/null || true)"
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    "/Applications/Chromium.app/Contents/MacOS/Chromium"
  )
  for c in "${candidates[@]}"; do
    if [[ -n "$c" && -x "$c" ]]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

STOP_SIGNAL_FILE="${RUNTIME_DIR}/stop.signal"

is_pid_alive() {
  local pid_file="$1"
  local expected="${2:-}"
  if [[ -f "$pid_file" ]]; then
    local pid cmdline
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$pid" && "$pid" != "$$" ]] && kill -0 "$pid" 2>/dev/null; then
      if [[ -n "$expected" ]]; then
        if [[ -r "/proc/${pid}/cmdline" ]]; then
          cmdline="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null || true)"
        else
          cmdline="$(ps -ww -p "$pid" -o command= 2>/dev/null || true)"
        fi
        [[ "$cmdline" == *"$expected"* ]] || return 1
      fi
      return 0
    fi
  fi
  return 1
}

stop_pid_file() {
  local pid_file="$1"
  local expected="${2:-}"
  if [[ ! -f "$pid_file" ]]; then
    return 0
  fi
  local pid
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if is_pid_alive "$pid_file" "$expected"; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 30); do
      if ! is_pid_alive "$pid_file" "$expected"; then
        break
      fi
      sleep 0.1
    done
    if is_pid_alive "$pid_file" "$expected"; then
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.1
    fi
  fi
  rm -f "$pid_file"
}

is_stack_reachable() {
  [[ -f "$TOKEN_FILE" ]] &&
    curl -fsS "${API_URL}/health" >/dev/null 2>&1 &&
    curl -fsS "${AI_URL}/__verify_health" >/dev/null 2>&1 &&
    curl -fsS "http://127.0.0.1:${CDP_PORT}/json/version" >/dev/null 2>&1
}

check_port_free() {
  local port="$1"
  local label="$2"
  if node -e "
    const net = require('node:net');
    const s = net.connect({ host: '127.0.0.1', port: ${port} });
    s.on('connect', () => { s.destroy(); process.exit(0); });
    s.on('error', () => process.exit(1));
  " 2>/dev/null; then
    echo "ERROR: Port ${port} (${label}) is already in use by another process. Refusing to clobber it; set SHELFD_VERIFY_RUN_ID / SHELFD_VERIFY_PORT / SHELFD_VERIFY_AI_PORT / SHELFD_VERIFY_CDP_PORT." >&2
    return 1
  fi
  return 0
}

ensure_web_bundle() {
  local web_dir="${REPO_ROOT}/apps/app/build/web"
  local main_js="${web_dir}/main.dart.js"
  local needs_build=0

  if [[ ! -f "$main_js" ]]; then
    needs_build=1
  elif find "${REPO_ROOT}/apps/app/lib" -name '*.dart' -newer "$main_js" | grep -q .; then
    needs_build=1
  fi

  if [[ "$needs_build" -eq 1 ]]; then
    echo "==> Building Flutter Web bundle (apps/app/build/web)..."
    local lock_clean=0
    if git -C "$REPO_ROOT" diff --quiet -- apps/app/pubspec.lock 2>/dev/null; then
      lock_clean=1
    fi
    (
      cd "${REPO_ROOT}/apps/app"
      run_tool flutter build web --release --no-web-resources-cdn
    )
    if [[ "$lock_clean" -eq 1 ]]; then
      git -C "$REPO_ROOT" checkout -- apps/app/pubspec.lock 2>/dev/null || true
    fi
  fi
}

seed_fixtures_and_config() {
  mkdir -p "${RUNTIME_DIR}/bin" "$LIBRARY_DIR" "$DATA_DIR" "$FIXTURES_DIR" "$EVIDENCE_DIR"

  cat >"$CONFIG_FILE" <<EOF
server:
  host: "127.0.0.1"
  port: ${API_PORT}
  jwt_secret: "${JWT_SECRET}"
  web_dir: "${REPO_ROOT}/apps/app/build/web"
database:
  type: "sqlite"
  sqlite:
    path: "${DATA_DIR}/sqlite.db"
storage:
  library_dir: "${LIBRARY_DIR}"
  data_dir: "${DATA_DIR}"
ai:
  provider: "ollama"
  base_url: "${AI_URL}"
  embedding_model: "nomic-embed-text"
  embedding_dimensions: 256
  chat_model: "llama3.2:3b"
mcp:
  enabled: true
  path: "/mcp"
auth:
  admin_username: "${ADMIN_USER}"
  admin_password: "${ADMIN_PASS}"
logging:
  level: "info"
  format: "text"
EOF

  LIBRARY_DIR="$LIBRARY_DIR" FIXTURES_DIR="$FIXTURES_DIR" SIDECAR_SUMS="$SIDECAR_SUMS" python3 - <<'PY'
import hashlib
import os
import shutil
import subprocess
import zipfile

lib_dir = os.environ["LIBRARY_DIR"]
