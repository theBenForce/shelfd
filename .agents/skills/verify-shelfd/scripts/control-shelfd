meta_path = os.path.join(dune_dir, ".metadata.json")
desc_path = os.path.join(dune_dir, "desc.txt")
with open(meta_path, "w", encoding="utf-8") as f:
    f.write('{"title":"Dune","author":"Frank Herbert","audiobookshelf_sidecar":true}\n')
with open(desc_path, "w", encoding="utf-8") as f:
    f.write("Audiobookshelf sidecar description — must never be modified by Shelfd.\n")

with open(sums_file, "w", encoding="utf-8") as sf:
    for p in (meta_path, desc_path):
        digest = hashlib.sha256(open(p, "rb").read()).hexdigest()
        sf.write(f"{digest}  {p}\n")

