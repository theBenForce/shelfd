    subprocess.run(
        [
            ffmpeg, "-y", "-loglevel", "error",
            "-f", "lavfi", "-i", "sine=frequency=440:duration=9",
            "-ac", "1", "-ar", "44100", "-b:a", "64k",
            "-metadata", "title=The Tale of Peter Rabbit",
            "-metadata", "artist=Beatrix Potter",
            mp3_path,
        ],
        check=True,
    )
else:
    # Pure-Python valid CBR 64kbps 44.1kHz mono MPEG-1 Layer 3 silent frames (~9.0s = 345 frames * 209 bytes)
    frame = bytes([0xFF, 0xFB, 0x50, 0xC4]) + b"\x00" * 205
    with open(mp3_path, "wb") as mf:
        mf.write(frame * 345)

