# Shelfd Local Environment Configuration Example
# Copy to .env and adjust variables as needed for your local environment.

# Library & File Permissions
LIBRARY_PATH=/Users/bforce/books
PUID=1000
PGID=1000

# Server & Authentication
SHELFD_SERVER_HOST=0.0.0.0
SHELFD_SERVER_PORT=8080
SHELFD_ADMIN_USERNAME=admin
SHELFD_ADMIN_PASSWORD=admin-secret-123
SHELFD_JWT_SECRET=shelfd-homelab-jwt-secret-key-32bytes

# Database Configuration (PostgreSQL container connection)
SHELFD_DATABASE_TYPE=postgres
SHELFD_DATABASE_POSTGRES_DSN="postgres://shelfd:shelfd_password@127.0.0.1:5432/shelfd?sslmode=disable"

# AI / LLM Configuration (omlx local OpenAI-compatible server)
SHELFD_AI_PROVIDER=openai
SHELFD_AI_BASE_URL=http://127.0.0.1:8000/v1
SHELFD_AI_API_KEY=omlx
SHELFD_AI_EMBEDDING_MODEL=text-embedding-3-small
SHELFD_AI_EMBEDDING_DIMENSIONS=256
SHELFD_AI_CHAT_MODEL=llama3.2:3b

# Storage Paths
SHELFD_STORAGE_LIBRARY_DIR=/Users/bforce/books
SHELFD_STORAGE_DATA_DIR=/Users/bforce/repos/shelved/data
