{
  "name": "@shelfd/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "mkdir -p dist && go build -tags sqlite_fts5 -v -o dist/shelfd ./cmd/server",
    "dev": "air",
